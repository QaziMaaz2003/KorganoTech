# --- Database (Supabase Postgres)
# Supabase dashboard → Connect → "Session pooler" (IPv4-friendly, supports migrations).
# URL-encode special characters in the password (e.g. ! → %21).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Server
PORT=3001
# Comma-separated list of allowed browser origins
FRONTEND_URL="http://localhost:3000"
NODE_ENV=development

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET="<at-least-32-random-characters>"
JWT_EXPIRES_IN_DAYS=7

# --- Cloudinary (product images)
CLOUDINARY_CLOUD_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_API_SECRET="<api-secret>"

# --- Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<strong-password>"
