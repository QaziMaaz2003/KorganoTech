# --- Database (Supabase Postgres)
# Supabase dashboard → Connect → "Session pooler" (IPv4-friendly, supports migrations).
# URL-encode special characters in the password (e.g. ! → %21).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Server
PORT=3001
# Comma-separated list of allowed browser origins
FRONTEND_URL="http://localhost:3000"
NODE_ENV=development

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET="<at-least-32-random-characters>"
JWT_EXPIRES_IN_DAYS=7

# --- Stripe (card payments)
# Secret key from https://dashboard.stripe.com/apikeys (use a test key, sk_test_..., until you go live).
# Without it checkout refuses to start instead of taking orders it cannot charge.
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret of the webhook endpoint (whsec_...). In the Stripe dashboard add an endpoint at
#   https://<your-backend-domain>/api/payments/stripe/webhook
# listening for: checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public address of the storefront, used for the Stripe success and cancel pages and for links in emails.
# Defaults to the first FRONTEND_URL.
# SITE_URL=https://www.example.com
# Sales tax by delivery address, worked out by Stripe Tax on the payment page. Set to true ONLY after
# Stripe Tax is switched on in the Stripe dashboard (business address + tax registrations); otherwise
# Stripe rejects the checkout. Off = no tax is added (or the flat taxRate from Admin -> Settings).
# STRIPE_TAX_ENABLED=true

# --- Email (Resend, https://resend.com)
# Order confirmation, shipped notice, refund confirmation and business login emails. Nothing is sent
# until both are set; the store works normally without them.
# The domain of MAIL_FROM must be verified in Resend (DNS records at the domain registrar).
# RESEND_API_KEY=re_...
# MAIL_FROM="KorganoTech <orders@korganotech.com>"
# MAIL_REPLY_TO=Support@KorganoTech.com

# --- Cloudinary (product images)
CLOUDINARY_CLOUD_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_API_SECRET="<api-secret>"

# --- Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<strong-password>"

# --- Serverless tuning (optional)
# Connections kept per server instance. Defaults: 3 on Vercel, 10 elsewhere.
# DB_POOL_MAX=3
# Set to false only for a local database without TLS.
# DB_SSL=false
# How many proxies sit in front of the API (used for client IPs and rate limits).
# TRUST_PROXY_HOPS=1
