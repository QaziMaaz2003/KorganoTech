// KorganoTech store — catalog, customers, carts, orders and admin data.
// Hosted on Supabase Postgres. Every table has RLS enabled (see the
// enable_rls migration) so Supabase's public REST API cannot reach it; the
// NestJS backend connects as `postgres`, which bypasses RLS.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and is
// supplied to PrismaClient through the pg driver adapter at runtime.
datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum StockReason {
  ORDER
  CANCEL
  ADJUSTMENT
  RESTOCK
}

enum InquiryType {
  CONTACT_SALES
  FRANCHISE
  PRODUCT_INTEREST
  GENERAL
}

enum InquiryStatus {
  NEW
  READ
  ARCHIVED
}

// ─── Customers ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  /// Bumped on logout / role change so previously issued JWTs stop working.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses      Address[]
  cart           Cart?
  orders         Order[]
  statusChanges  OrderStatusHistory[]
  stockMovements StockMovement[]

  @@index([role])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("United States")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Catalog ────────────────────────────────────────────────────────────────

/// The three KorganoTech programs: hvac, pathogen, environmental.
model Category {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  tagline       String?
  description   String?
  /// Shown as a badge, e.g. "Available Now", "Under Development".
  statusLabel   String?
  imageUrl      String?
  imagePublicId String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]
}

model Product {
  id               String        @id @default(cuid())
  categoryId       String
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?
  features         String[]      @default([])
  /// [{ "label": "Frame", "value": "Moisture-resistant beverage board" }]
  specs            Json?
  /// e.g. "Pleated", "Deep Pleat", "Nanofiber", "Sorbent media"
  filterType       String?
  status           ProductStatus @default(DRAFT)
  /// When false the storefront shows "Notify me" instead of Add to Cart.
  isPurchasable    Boolean       @default(true)
  isFeatured       Boolean       @default(false)
  badge            String?
  /// Shown when not purchasable, e.g. "EPA registration underway".
  availabilityNote String?
  seoTitle         String?
  seoDescription   String?
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  variants ProductVariant[]

  @@index([categoryId, status])
  @@index([isFeatured])
}

/// Images live on Cloudinary; this row holds the delivery URL and public_id.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  publicId  String?
  alt       String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// One purchasable SKU: a size × MERV rating × pack quantity.
model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  /// Nominal size label, e.g. "16x25x1" (or a free label for non-HVAC items).
  size              String
  width             Decimal? @db.Decimal(6, 2)
  height            Decimal? @db.Decimal(6, 2)
  depth             Decimal? @db.Decimal(5, 2)
  /// Actual (measured) size, e.g. "15.5 x 24.5 x 0.75"
  actualSize        String?
  mervRating        Int?
  packQuantity      Int      @default(1)
  price             Decimal  @db.Decimal(10, 2)
  compareAtPrice    Decimal? @db.Decimal(10, 2)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(10)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([productId, size, mervRating, packQuantity])
  @@index([size])
  @@index([mervRating])
}

model StockMovement {
  id         String      @id @default(cuid())
  variantId  String
  delta      Int
  stockAfter Int
  reason     StockReason
  note       String?
  orderId    String?
  userId     String?
  createdAt  DateTime    @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
}

// ─── Cart ───────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ─── Orders ─────────────────────────────────────────────────────────────────

model Order {
  id            String        @id @default(cuid())
  /// Human-facing order number; the sequence starts at 100001 (see migration).
  number        Int           @unique @default(autoincrement())
  userId        String?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)
  currency      String        @default("USD")
  subtotal      Decimal       @db.Decimal(10, 2)
  shippingFee   Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)

  email          String
  phone          String
  shipFullName   String
  shipPhone      String
  shipLine1      String
  shipLine2      String?
  shipCity       String
  shipState      String
  shipPostalCode String
  shipCountry    String
  customerNote   String?

  carrier        String?
  trackingNumber String?

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  paidAt      DateTime?
  updatedAt   DateTime  @updatedAt

  user    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([userId, placedAt])
  @@index([status])
  @@index([placedAt])
}

/// Snapshot of what was bought, so history survives catalog edits/deletes.
model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  variantId    String?
  productId    String?
  productName  String
  productSlug  String?
  variantLabel String
  sku          String
  imageUrl     String?
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// ─── Inbound messages & settings ────────────────────────────────────────────

model Inquiry {
  id          String        @id @default(cuid())
  type        InquiryType
  status      InquiryStatus @default(NEW)
  name        String
  email       String
  phone       String?
  company     String?
  /// Contact Sales form: "MERV 13" | "MERV 11" | "Custom Size" | "Other"
  productType String?
  /// For PRODUCT_INTEREST ("Notify me") requests
  productId   String?
  productName String?
  message     String
  ipAddress   String?
  createdAt   DateTime      @default(now())

  @@index([type, status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Single-row store configuration (id is always 1).
model StoreSettings {
  id                    Int      @id @default(1)
  storeName             String   @default("KorganoTech")
  supportEmail          String?
  supportPhone          String?
  address               String?
  currency              String   @default("USD")
  shippingFee           Decimal  @default(9.99) @db.Decimal(10, 2)
  /// Orders at or above this subtotal ship free; null disables free shipping.
  freeShippingThreshold Decimal? @default(75) @db.Decimal(10, 2)
  /// Fraction, e.g. 0.0725 for 7.25%.
  taxRate               Decimal  @default(0) @db.Decimal(5, 4)
  codEnabled            Boolean  @default(true)
  announcement          String?
  updatedAt             DateTime @updatedAt
}
