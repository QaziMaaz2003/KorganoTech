# Base URL of the NestJS API (no trailing slash). The browser reaches it through
# the /api rewrite in next.config.ts, so it never needs to be public.
API_URL="http://localhost:3001"

# Public URL of this site (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Support email shown in the header and used for return authorizations (no phone number).
# Defaults to support@korganotech.com when not set.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Cloudinary cloud name (optional; defaults to the KorganoTech account). Must match
# the CLOUDINARY_CLOUD_NAME the backend uploads to, or product images will not load.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dmaf8fdeu"
